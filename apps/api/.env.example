# Pooled connection used by the API at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Direct connection used by Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"
# Signs session cookies; generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
# Public web origin that proxies /api to this server.
BETTER_AUTH_URL="http://localhost:5173"
# Optional locally. In production the web proxy sends it and the API refuses requests without it.
# PROXY_SECRET=""
